<Window x:Class="AIDictation.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIDictation.ViewModels"
        mc:Ignorable="d"
        Title="AIDictation Setup"
        Width="900" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LtBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

    <Window.DataContext>
        <vm:OnboardingViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Step title (Figtree brand display) -->
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FigtreeFont}"/>
            <Setter Property="FontSize" Value="33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource LtInkBrush}"/>
            <Setter Property="LineHeight" Value="36"/>
        </Style>
        <Style x:Key="StepSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource LtSubBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="MaxWidth" Value="430"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Light language chip -->
        <Style x:Key="LightChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource LtInkBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{StaticResource LtCardBrush}"
                                BorderBrush="{StaticResource LtStrokeBrush}" BorderThickness="1.5"
                                CornerRadius="999" Padding="14,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CFC7BD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#9A4A00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode row (mac parity) -->
        <Style x:Key="ModeRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LtCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LtStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StarOn" TargetType="TextBlock">
            <Setter Property="Text" Value="★"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,1.5,0"/>
        </Style>
        <Style x:Key="StarOff" TargetType="TextBlock" BasedOn="{StaticResource StarOn}">
            <Setter Property="Foreground" Value="#D9D3CA"/>
        </Style>
        <Style x:Key="StarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource LtSubBrush}"/>
            <Setter Property="Width" Value="40"/>
        </Style>

        <!-- Keyboard key -->
        <Style x:Key="KbKey" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.10" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KbKeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3A3530"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Color option -->
        <Style x:Key="ColorOption" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LtCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LtStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="205"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============ Split layout ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left: content -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dots -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Ellipse">
                            <Setter Property="Width" Value="7"/>
                            <Setter Property="Height" Value="7"/>
                            <Setter Property="Margin" Value="4,0"/>
                            <Setter Property="Fill" Value="#DDD7CF"/>
                        </Style>
                    </StackPanel.Resources>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="0"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                </StackPanel>

                <!-- Step content -->
                <Grid Grid.Row="1" Margin="44,16,40,8">

                    <!-- 0: Microphone permission -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
                        <TextBlock Style="{StaticResource StepTitle}">Microphone<LineBreak/>Access</TextBlock>
                        <TextBlock Style="{StaticResource StepSub}"
                                   Text="AIDictation needs your microphone to record and transcribe your voice. Windows will ask once."/>
                        <Button Style="{StaticResource AccentButton}" Content="Open Windows Settings"
                                Command="{Binding OpenMicrophoneSettingsCommand}"
                                HorizontalAlignment="Left" Margin="0,26,0,0"/>
                    </StackPanel>

                    <!-- 1: Languages -->
                    <StackPanel VerticalAlignment="Top" Margin="0,18,0,0"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Your languages"/>
                        <TextBlock Style="{StaticResource StepSub}"
                                   Text="Pick every language you dictate in — or let auto-detect figure it out."/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="470" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource LightChip}"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Flag}" FontSize="14" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 2: Transcription mode -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                        <TextBlock Style="{StaticResource StepTitle}">How should we<LineBreak/>transcribe?</TextBlock>
                        <TextBlock Style="{StaticResource StepSub}" Text="You can change this anytime in Settings."/>

                        <StackPanel Margin="0,22,0,0" MaxWidth="460" HorizontalAlignment="Left">
                            <!-- Cloud -->
                            <Border MouseLeftButtonUp="ModeCloud_Click">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ModeRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedModeKey, Converter={StaticResource EqualityConverter}, ConverterParameter=aidictation}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Background" Value="#0FF16E00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="21" Height="21" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse Stroke="#C9C2B8" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Ellipse x:Name="ckCloud" Fill="{StaticResource PrimaryBrush}"
                                                 Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=aidictation}"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=aidictation}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Cloud" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource LtInkBrush}"/>
                                        <TextBlock Text="Best accuracy, requires internet" FontSize="11.5" Foreground="{StaticResource LtSubBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Speed"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOff}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Quality"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- On-device -->
                            <Border MouseLeftButtonUp="ModeLocal_Click">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ModeRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedModeKey, Converter={StaticResource EqualityConverter}, ConverterParameter=local}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Background" Value="#0FF16E00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="21" Height="21" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse Stroke="#C9C2B8" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Ellipse Fill="{StaticResource PrimaryBrush}"
                                                 Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=local}"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=local}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="On-device" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource LtInkBrush}"/>
                                        <TextBlock Text="Private — audio never leaves this PC" FontSize="11.5" Foreground="{StaticResource LtSubBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Speed"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Quality"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOff}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Automatic -->
                            <Border MouseLeftButtonUp="ModeAuto_Click">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ModeRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedModeKey, Converter={StaticResource EqualityConverter}, ConverterParameter=auto}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Background" Value="#0FF16E00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="21" Height="21" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse Stroke="#C9C2B8" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Ellipse Fill="{StaticResource PrimaryBrush}"
                                                 Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=auto}"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedModeKey, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=auto}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Automatic" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource LtInkBrush}"/>
                                        <TextBlock Text="Cloud when online, on-device when offline" FontSize="11.5" Foreground="{StaticResource LtSubBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Speed"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Style="{StaticResource StarLabel}" Text="Quality"/>
                                            <TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/><TextBlock Style="{StaticResource StarOn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Model status: fixed height so it never shifts layout -->
                        <Grid Height="34" MaxWidth="460" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Margin="0,0,9,0"
                                        Visibility="{Binding IsModelDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="spinT" CenterX="6.5" CenterY="6.5"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="spinT" Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:0.9"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                             StrokeDashArray="6 3"/>
                                </Border>
                                <Border Width="15" Height="15" CornerRadius="8" Background="{StaticResource SuccessBrush}" Margin="0,0,9,0"
                                        Visibility="{Binding IsModelReady, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="8" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ModelStatusText}" FontSize="12"
                                           Foreground="{StaticResource LtSubBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 3: Overlay color -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Make it yours"/>
                        <TextBlock Style="{StaticResource StepSub}"
                                   Text="Pick the accent for the recording pill. You can change it later in Settings → Configuration."/>
                        <ItemsControl ItemsSource="{Binding ThemeOptions}" Margin="0,20,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MaxWidth="440" HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonUp="ThemeOption_Click" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ColorOption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{Binding Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="26" Margin="0,0,10,0">
                                                <Ellipse Fill="{Binding Brush}"/>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="10" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource LtInkBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4: Hotkey -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}">
                        <TextBlock Style="{StaticResource StepTitle}">Recording<LineBreak/>Hotkey</TextBlock>
                        <TextBlock Style="{StaticResource StepSub}"
                                   Text="Press it anywhere on your PC to start and stop dictating."/>
                        <Border Width="320" HorizontalAlignment="Left" Margin="0,24,0,0"
                                Background="{StaticResource LtCardBrush}" CornerRadius="13" Padding="16,14"
                                BorderThickness="1.5" Cursor="Hand"
                                MouseLeftButtonDown="HotkeyRecorder_MouseLeftButtonDown" Focusable="True">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#CFC7BD"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" BorderBrush="{StaticResource LtStrokeBrush}"
                                        BorderThickness="1,1,1,3" CornerRadius="7" Padding="13,6" HorizontalAlignment="Left">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource LtInkBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding HotkeyDisplayText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                        <Setter Property="Text" Value="Press any key…"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕ reset" FontSize="12"
                                        Command="{Binding ClearHotkeyCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource LtSubBrush}" Margin="0,14,0,0"
                                   Text="Tip: function keys (F1–F12) work best — other apps rarely use them."/>
                    </StackPanel>

                    <!-- 5: First recording -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=5}">
                        <TextBlock Style="{StaticResource StepTitle}">Try your first<LineBreak/>recording</TextBlock>
                        <TextBlock Style="{StaticResource StepSub}" Text="Click into the box, then dictate hands-free."/>
                        <Border Background="{StaticResource LtCardBrush}" BorderBrush="{StaticResource LtStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" MaxWidth="440" MinHeight="96"
                                HorizontalAlignment="Left" Margin="0,22,0,0" Width="440">
                            <TextBox x:Name="TestField" Background="Transparent" BorderThickness="0"
                                     FontSize="13.5" Foreground="{StaticResource LtInkBrush}"
                                     Padding="13,11" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     CaretBrush="{StaticResource PrimaryBrush}"/>
                        </Border>
                        <StackPanel Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock Text="Hold " FontSize="13.5" Foreground="{StaticResource LtInkBrush}"/>
                                <Border Background="White" BorderBrush="{StaticResource LtStrokeBrush}"
                                        BorderThickness="1,1,1,2.5" CornerRadius="6" Padding="9,2">
                                    <TextBlock Text="{Binding HotkeyDisplayText}" FontFamily="{StaticResource MonoFont}"
                                               FontWeight="Bold" FontSize="11" Foreground="{StaticResource LtInkBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource LtInkBrush}" Margin="0,0,0,9">
                                Say: <Run FontStyle="Italic" Foreground="{StaticResource LtSubBrush}">“This is my first recording.”</Run>
                            </TextBlock>
                            <TextBlock Text="Release when you are done" FontSize="13.5" Foreground="{StaticResource LtInkBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 6: Account -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=6}">
                        <TextBlock Style="{StaticResource StepTitle}">Sign in to<LineBreak/>your account</TextBlock>
                        <TextBlock Style="{StaticResource StepSub}"
                                   Text="Your free account includes cloud transcription and keeps your plan in sync across devices. Sign-in opens in your browser."/>
                        <StackPanel Margin="0,26,0,0"
                                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Button Style="{StaticResource AccentButton}" Content="Sign In with Browser"
                                    Command="{Binding SignInCommand}" HorizontalAlignment="Left"/>
                            <TextBlock Text="You can also do this later from Settings → Account."
                                       FontSize="11.5" Foreground="{StaticResource LtSubBrush}" Margin="0,14,0,0"/>
                        </StackPanel>
                        <Border Background="#F0FAF2" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16" MinWidth="320" MaxWidth="420"
                                HorizontalAlignment="Left" Margin="0,26,0,0"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SuccessBrush}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Signed in" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LtInkBrush}"/>
                                    <TextBlock Text="{Binding AccountEmail}" FontSize="12.5" Foreground="{StaticResource LtSubBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Nav -->
                <Grid Grid.Row="2" Margin="44,0,40,26">
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left"
                            Command="{Binding PreviousStepCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource AccentButton}" Content="{Binding NextButtonText}"
                            HorizontalAlignment="Right" Command="{Binding NextStepCommand}"/>
                </Grid>
            </Grid>

            <!-- Right: gradient panel with per-step artwork -->
            <Border Grid.Column="1" Background="{StaticResource BrandGradientBrush}">
                <Grid>
                    <!-- 0: Windows 11 consent dialog -->
                    <Border Width="250" Background="#F9F9F9" CornerRadius="8" Padding="20,22,20,18"
                            BorderBrush="#17000000" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.25" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="22" Background="#E8F1FB" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource Glyphs}" FontSize="20" Foreground="#0067C0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Let AIDictation access your microphone?" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1B1B1B" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11.5" Foreground="#5F5F5F" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"
                                       Text="AIDictation needs your microphone to record audio for transcription. You can change this later in Privacy settings."/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Border Background="#0067C0" CornerRadius="4" Padding="0,7" BorderThickness="1,1,1,2" BorderBrush="#33000000">
                                        <TextBlock Text="Yes" FontSize="12.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Path Data="M5,3 L19,12 L12.5,13.5 L16,20 L13,21.4 L9.6,14.8 L5,19 Z"
                                          Fill="White" Stroke="#1B1B1B" StrokeThickness="1.4"
                                          Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-13"/>
                                </Grid>
                                <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="0,7"
                                        BorderThickness="1,1,1,2" BorderBrush="#1F000000">
                                    <TextBlock Text="No" FontSize="12.5" FontWeight="SemiBold" Foreground="#1B1B1B" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1: Languages artwork -->
                    <Image Source="/Resources/Onboarding/onboarding_languages.png" Stretch="Uniform" MaxWidth="290"
                           Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.2" Direction="270"/>
                        </Image.Effect>
                    </Image>

                    <!-- 2: Mode emblem -->
                    <Border Background="White" CornerRadius="16" Padding="32"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.22" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="ModeGlyph" Text="&#xE753;" FontFamily="{StaticResource Glyphs}" FontSize="50"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Your voice, your choice" FontFamily="{StaticResource FigtreeFont}"
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource LtInkBrush}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3: Color pill preview (mac overlayColorPreview) -->
                    <Border Background="White" CornerRadius="16" Padding="28,30"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.22" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Background="{Binding PreviewBrush}" CornerRadius="99" Padding="14,9" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#F2FFFFFF" Margin="0,0,7,0">
                                        <TextBlock Text="✕" FontSize="9" FontWeight="Bold" Foreground="{Binding PreviewBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Width" Value="4"/>
                                                <Setter Property="RadiusX" Value="2"/>
                                                <Setter Property="RadiusY" Value="2"/>
                                                <Setter Property="Fill" Value="#EBFFFFFF"/>
                                                <Setter Property="Margin" Value="0,0,3,0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <Rectangle Height="5"/><Rectangle Height="12"/><Rectangle Height="17"/><Rectangle Height="12"/>
                                        <Rectangle Height="19"/><Rectangle Height="17"/><Rectangle Height="21"/><Rectangle Height="20"/>
                                        <Rectangle Height="12"/><Rectangle Height="5"/>
                                    </StackPanel>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#F2FFFFFF" Margin="4,0,0,0">
                                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding PreviewBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Lives quietly at the&#10;edge of your screen" FontFamily="{StaticResource FigtreeFont}"
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource LtInkBrush}"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4: Keyboard crop, F8 hot -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}">
                        <Border Background="#EDEAE6" CornerRadius="18" Padding="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-2"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="44" ShadowDepth="18" Opacity="0.22" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" FontSize="10.5" Foreground="#6B655D" Text="F4"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" FontSize="10.5" Foreground="#6B655D" Text="F5"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" FontSize="10.5" Foreground="#6B655D" Text="F6"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" FontSize="10.5" Foreground="#6B655D" Text="F7"/></Border>
                                    <Border Style="{StaticResource KbKey}" Background="{StaticResource PrimaryBrush}" Margin="0">
                                        <TextBlock Style="{StaticResource KbKeyText}" Text="F8" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="4"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="5"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="6"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="7"/></Border>
                                    <Border Style="{StaticResource KbKey}" Margin="0"><TextBlock Style="{StaticResource KbKeyText}" Text="8"/></Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="R"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="T"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="Y"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="U"/></Border>
                                    <Border Style="{StaticResource KbKey}" Margin="0"><TextBlock Style="{StaticResource KbKeyText}" Text="I"/></Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="F"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="G"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="H"/></Border>
                                    <Border Style="{StaticResource KbKey}"><TextBlock Style="{StaticResource KbKeyText}" Text="J"/></Border>
                                    <Border Style="{StaticResource KbKey}" Margin="0"><TextBlock Style="{StaticResource KbKeyText}" Text="K"/></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Path Data="M5,3 L19,12 L12.5,13.5 L16,20 L13,21.4 L9.6,14.8 L5,19 Z"
                              Fill="White" Stroke="#1B1B1B" StrokeThickness="1.4"
                              Width="26" Height="26" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,168,52,0">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.35" Direction="270"/>
                            </Path.Effect>
                        </Path>
                    </Grid>

                    <!-- 5: Dictation artwork -->
                    <Image Source="/Resources/Onboarding/onboarding_dictation.png" Stretch="Uniform" MaxWidth="280"
                           Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=5}">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.2" Direction="270"/>
                        </Image.Effect>
                    </Image>

                    <!-- 6: Account emblem -->
                    <Border Background="White" CornerRadius="16" Padding="32"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=6}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.22" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Glyphs}" FontSize="50"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="One account,&#10;every device" FontFamily="{StaticResource FigtreeFont}"
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource LtInkBrush}"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Finale: gradient grows over the window (mac parity) ============ -->
        <Border x:Name="FinaleLayer" Background="{StaticResource BrandGradientBrush}"
                HorizontalAlignment="Right" Width="350" Visibility="Collapsed">
            <Grid>
                <Border x:Name="FinaleCard" Background="White" CornerRadius="22" Padding="54,44"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="FinaleCardScale" ScaleX="0.8" ScaleY="0.8"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.28" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="FinaleCheck" Width="72" Height="72" CornerRadius="36"
                                Background="{StaticResource SuccessBrush}" HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5" Margin="0,0,0,20">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FinaleCheckScale" ScaleX="0" ScaleY="0"/>
                            </Border.RenderTransform>
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="30" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="FinaleTitle" Text="You're ready" FontFamily="{StaticResource FigtreeFont}"
                                   FontWeight="ExtraBold" FontSize="29" Foreground="{StaticResource LtInkBrush}"
                                   HorizontalAlignment="Center" Opacity="0"/>
                        <TextBlock x:Name="FinaleBody" FontSize="13.5" Foreground="{StaticResource LtSubBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,26" LineHeight="20" Opacity="0">
                            Press <Run FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12">F8</Run> in any app to start dictating. AIDictation lives in your system tray.
                        </TextBlock>
                        <Button x:Name="FinaleButton" Style="{StaticResource AccentButton}" Content="Let's Go!"
                                Padding="38,12" HorizontalAlignment="Center" Opacity="0"
                                Command="{Binding CompleteCommand}" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="FinaleButtonScale" ScaleX="0.9" ScaleY="0.9"/>
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
