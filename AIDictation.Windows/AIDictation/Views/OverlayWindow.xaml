<Window x:Class="AIDictation.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIDictation Overlay"
        Width="260" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False">

    <!-- Morphing pill, ported from macOS RecordingOverlayView:
         collapsed 53x7 strip <-> accent capsule, morph 260ms KeySpline(.2,.8,.2,1),
         content fades 140ms after, collapse 150ms. No text - pure graphic. -->
    <!-- Hover handlers live on the visible pill, not the Root grid: the window
         is a large transparent rect and MouseEnter on Root fires for the whole
         invisible area, expanding the pill when the cursor merely passes near it. -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Pill"
                Width="53" Height="7"
                CornerRadius="3.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Cursor="Hand"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/>
            </Border.Effect>

            <Grid x:Name="PillContent" Opacity="0">
                <!-- Idle dots (10) -->
                <StackPanel x:Name="IdleDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed"/>

                <!-- Live waveform (10 bars) -->
                <StackPanel x:Name="WaveBars" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed"/>

                <!-- Processing sweep dots (10) -->
                <StackPanel x:Name="SweepDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed"/>

                <!-- Recording controls: cancel / stop -->
                <Grid x:Name="ControlsRow" Visibility="Collapsed" Margin="5,0">
                    <Border x:Name="CancelButton" Width="22" Height="22" CornerRadius="11"
                            Background="#2EFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonUp="CancelButton_Click"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CancelScale" ScaleX="0.74" ScaleY="0.74"/>
                        </Border.RenderTransform>
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="9" FontWeight="Bold" Foreground="#EBFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="StopButton" Width="22" Height="22" CornerRadius="11"
                            Background="#48000000" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonUp="StopButton_Click"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="StopScale" ScaleX="0.74" ScaleY="0.74"/>
                        </Border.RenderTransform>
                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
