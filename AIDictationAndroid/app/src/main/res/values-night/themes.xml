<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Night variant of the app theme. Compose screens pick their own dark palette, but
        the accessibility overlay (bubble, wand button, rewrite panel) resolves its
        surface, text and outline colours from these XML attributes, so without this
        file the overlay stays light over dark apps.
    -->
    <style name="Theme.AIDictation" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/figtree_variable</item>
        <item name="android:colorPrimary">@color/brand_black</item>
        <item name="android:colorSecondary">@color/brand_orange</item>
        <item name="android:colorAccent">@color/brand_orange</item>
        <item name="android:colorBackground">#FF131519</item>
        <item name="android:colorBackgroundFloating">#FF1E2126</item>
        <item name="android:textColorPrimary">#FFECEEF2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
