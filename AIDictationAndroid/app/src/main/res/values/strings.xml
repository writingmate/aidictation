    <string name="onboarding_overlay_subtitle">A small mic appears when you tap into a place where you can type.</string>
    <string name="onboarding_accessibility_disclosure_title">Accessibility disclosure</string>
    <string name="onboarding_accessibility_disclosure_intro">AIDictation uses Android AccessibilityService to show the floating microphone when a text field is focused and to insert your dictated text at the cursor.</string>
    <string name="onboarding_accessibility_disclosure_use">AccessibilityService lets AIDictation detect editable text fields, read the current text and cursor position in the active field, and replace or insert text only when you start dictation or apply a command.</string>
    <string name="onboarding_accessibility_disclosure_data">Text from the active field may be processed for dictation insertion, grammar fixes, rewrites, shortcuts, and cleanup. It is not used to read passwords, payment fields, or secure screens.</string>
    <string name="onboarding_accessibility_disclosure_cloud">If cloud transcription or AI cleanup is enabled, your recorded audio and relevant text may be sent to AIDictation's transcription and AI providers to complete the requested action. You can use local transcription where available.</string>
    <string name="onboarding_accessibility_disclosure_consent">I understand and agree to this AccessibilityService use.</string>
    <string name="onboarding_accessibility_disclosure_continue">Agree and Continue</string>
    <string name="onboarding_overlay_step1">Turn on AIDictation in Accessibility settings</string>
    <string name="onboarding_overlay_step2">Tap the writing area below so your keyboard opens</string>
    <string name="onboarding_overlay_step3">Use the floating mic and make sure your words appear</string>
    <string name="onboarding_overlay_hint">The mic does not appear in password fields or secure screens.</string>
    <string name="onboarding_overlay_test_label">Try it here</string>
    <string name="onboarding_overlay_test_placeholder">Tap here. When the mic appears, say something like “This is a quick test.”</string>
    <string name="onboarding_try_dictation">Say a short test first</string>
