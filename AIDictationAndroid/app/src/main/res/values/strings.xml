    <string name="onboarding_accessibility_disclosure_title">Allow text field access?</string>
    <string name="onboarding_accessibility_disclosure_intro">AI Dictation uses Android AccessibilityService only so you can dictate into text fields in other apps.</string>
    <string name="onboarding_accessibility_visual_find_title">Find text fields</string>
    <string name="onboarding_accessibility_visual_find_body">Detects when an editable field is focused so the floating mic can appear.</string>
    <string name="onboarding_accessibility_visual_insert_title">Insert your words</string>
    <string name="onboarding_accessibility_visual_insert_body">Uses cursor position and current text only when you dictate or apply a command.</string>
    <string name="onboarding_accessibility_visual_private_title">Skips secure fields</string>
    <string name="onboarding_accessibility_visual_private_body">Does not read passwords, payment fields, or secure screens.</string>
    <string name="onboarding_accessibility_visual_processing_title">Process only on action</string>
    <string name="onboarding_accessibility_visual_processing_body">Cloud transcription or AI cleanup may send recorded audio and relevant text to complete your request. Offline transcription is available where supported.</string>
    <string name="onboarding_accessibility_disclosure_use">With your consent, AI Dictation can detect editable text fields, read the current text and cursor position in the active field, and replace or insert text only when you start dictation or apply a command.</string>
    <string name="onboarding_accessibility_disclosure_data">Text from the active field may be processed for dictation insertion, grammar fixes, rewrites, shortcuts, and cleanup. AI Dictation does not read passwords, payment fields, or secure screens.</string>
    <string name="onboarding_accessibility_disclosure_cloud">If cloud mode or AI cleanup is enabled, your recorded audio and relevant text may be sent to AI Dictation transcription and AI services to complete the action you requested. Offline mode is available where supported.</string>
