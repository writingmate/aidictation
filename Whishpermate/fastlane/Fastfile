# Fastfile - WhisperMate iOS Automation

default_platform(:ios)

# Before all lanes - set up API Key authentication
# Temporarily disabled due to OpenSSL incompatibility in fastlane 2.210.1
# before_all do
#   # Use App Store Connect API key instead of username/password
#   app_store_connect_api_key(
#     key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
#     issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
#     key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
#     in_house: false
#   )
# end

def provisioning_profile_settings(profile)
  uuid_pattern = /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/i
  profile.match?(uuid_pattern) ? { profile_uuid: profile } : { profile_name: profile }
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s

  return nil if key_id.empty? || issuer_id.empty? || key_filepath.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: File.expand_path(key_filepath),
    in_house: false
  )
end

platform :ios do
  # Variables
  app_identifier = "com.whispermate.ios"
  team_id = "G7DJ6P37KU"

  #####################################
  # Lane: Setup
  #####################################
  desc "Initial setup - create App Store Connect app, provisioning profiles, etc."
  lane :setup do
    # Create app in App Store Connect
    produce(
      app_identifier: app_identifier,
      app_name: "WhisperMate",
      language: "English",
      app_version: "0.0.92",
      sku: "whispermate-ios",
      team_id: team_id,
      platforms: ["ios"]
    )

    # Create provisioning profiles
    match(
      type: "appstore",
      app_identifier: [app_identifier, "#{app_identifier}.keyboard"],
      team_id: team_id,
      readonly: false
    )

    UI.success("✅ Setup complete! App created and provisioning profiles generated.")
  end

  #####################################
  # Lane: Build
  #####################################
  desc "Build the app for App Store"
  lane :build do
    committed_build_number = get_info_plist_value(
      path: "WhisperMateIOS/Info.plist",
      key: "CFBundleVersion"
    ).to_i

    # Use the committed build number by default so App Review resubmissions are
    # reproducible. Set IOS_BUILD_NUMBER explicitly when a higher build is needed.
    if !ENV["IOS_BUILD_NUMBER"].to_s.empty?
      requested_build_number = ENV["IOS_BUILD_NUMBER"].to_i
      UI.user_error!("IOS_BUILD_NUMBER must be at least the committed iOS build number") if requested_build_number < committed_build_number

      if requested_build_number > committed_build_number
        increment_build_number(
          xcodeproj: "Whispermate.xcodeproj",
          build_number: ENV["IOS_BUILD_NUMBER"]
        )
      else
        UI.message("Using committed iOS build number #{committed_build_number}")
      end
    else
      UI.message("Using committed iOS build number #{committed_build_number}")
    end

    # Update provisioning profiles
    # Using manually installed profiles instead
    # match(
    #   type: "appstore",
    #   app_identifier: [app_identifier, "#{app_identifier}.keyboard"],
    #   team_id: team_id,
    #   readonly: true
    # )

    gym_options = {
      scheme: "WhisperMateIOS",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "WhisperMate.ipa",
      clean: true,
      export_team_id: team_id
    }

    if ENV["IOS_USE_AUTOMATIC_SIGNING"].to_s == "1"
      auth_args = ""
      if !ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s.empty?
        auth_args = "-allowProvisioningUpdates -authenticationKeyPath #{File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_KEY"])} -authenticationKeyID #{ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]} -authenticationKeyIssuerID #{ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]}"
      end
      app_profile = ENV["IOS_APPSTORE_PROFILE_NAME"].to_s
      keyboard_profile = ENV["IOS_KEYBOARD_APPSTORE_PROFILE_NAME"].to_s
      live_activity_profile = ENV["IOS_LIVE_ACTIVITY_APPSTORE_PROFILE_NAME"].to_s
      UI.user_error!("IOS_APPSTORE_PROFILE_NAME is required for CI signing") if app_profile.empty?
      UI.user_error!("IOS_KEYBOARD_APPSTORE_PROFILE_NAME is required for CI signing") if keyboard_profile.empty?
      UI.user_error!("IOS_LIVE_ACTIVITY_APPSTORE_PROFILE_NAME is required for CI signing") if live_activity_profile.empty?

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Whispermate.xcodeproj",
        team_id: team_id,
        targets: ["WhisperMateIOS"],
        build_configurations: ["Release"],
        code_sign_identity: "iPhone Distribution",
        **provisioning_profile_settings(app_profile)
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Whispermate.xcodeproj",
        team_id: team_id,
        targets: ["WhisperMateKeyboard"],
        build_configurations: ["Release"],
        code_sign_identity: "iPhone Distribution",
        **provisioning_profile_settings(keyboard_profile)
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Whispermate.xcodeproj",
        team_id: team_id,
        targets: ["WhisperMateLiveActivity"],
        build_configurations: ["Release"],
        code_sign_identity: "iPhone Distribution",
        **provisioning_profile_settings(live_activity_profile)
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Whispermate.xcodeproj",
        team_id: team_id,
        targets: ["ParakeetRuntime", "PermissionFlowRuntime"],
        build_configurations: ["Release"],
        code_sign_identity: "iPhone Distribution"
      )

      gym_options[:xcargs] = [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=\"iPhone Distribution\"",
        auth_args
      ].reject(&:empty?).join(" ")
      gym_options[:export_options] = {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        provisioningProfiles: {
          "com.whispermate.ios" => app_profile,
          "com.whispermate.ios.keyboard" => keyboard_profile,
          "com.whispermate.ios.liveactivity" => live_activity_profile
        }
      }
    else
      app_profile = ENV["IOS_APPSTORE_PROFILE_NAME"].to_s
      keyboard_profile = ENV["IOS_KEYBOARD_APPSTORE_PROFILE_NAME"].to_s
      live_activity_profile = ENV["IOS_LIVE_ACTIVITY_APPSTORE_PROFILE_NAME"].to_s
      UI.user_error!("IOS_APPSTORE_PROFILE_NAME is required to export the iOS app with an App Store distribution profile") if app_profile.empty?
      UI.user_error!("IOS_KEYBOARD_APPSTORE_PROFILE_NAME is required to export the keyboard with an App Store distribution profile") if keyboard_profile.empty?
      UI.user_error!("IOS_LIVE_ACTIVITY_APPSTORE_PROFILE_NAME is required to export the Live Activity extension") if live_activity_profile.empty?

      gym_options[:xcargs] = "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"iPhone Distribution\""
      gym_options[:export_options] = {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        provisioningProfiles: {
          "com.whispermate.ios" => app_profile,
          "com.whispermate.ios.keyboard" => keyboard_profile,
          "com.whispermate.ios.liveactivity" => live_activity_profile
        }
      }
    end

    # Build and sign
    gym(**gym_options)

    UI.success("✅ Build complete!")
  end

  #####################################
  # Lane: Screenshots
  #####################################
  desc "Generate screenshots for all device sizes"
  lane :screenshots do
    capture_screenshots(
      scheme: "WhisperMateIOSUITests",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)"
      ],
      languages: ["en-US"],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true
    )

    # Optionally frame screenshots
    frameit(white: false, path: "./fastlane/screenshots")

    UI.success("✅ Screenshots captured!")
  end

  #####################################
  # Lane: Metadata
  #####################################
  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata do
    api_key = app_store_connect_api_key_from_env
    deliver_options = {
      app_identifier: app_identifier,
      team_id: team_id,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_app_version_update: false,
      force: true,
    }
    deliver_options[:api_key] = api_key if api_key

    if File.directory?("./fastlane/screenshots")
      deliver_options[:screenshots_path] = "./fastlane/screenshots"
      deliver_options[:overwrite_screenshots] = true
    else
      deliver_options[:skip_screenshots] = true
    end

    deliver(**deliver_options)

    UI.success("✅ Metadata uploaded!")
  end

  #####################################
  # Lane: Beta (TestFlight)
  #####################################
  desc "Upload to TestFlight"
  lane :beta do
    # Build app
    build

    # Upload to TestFlight
    pilot(
      app_identifier: app_identifier,
      team_id: team_id,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "WhisperMate v0.0.92 - App Review privacy, login, and support fixes"
    )

    UI.success("✅ Uploaded to TestFlight!")
  end

  #####################################
  # Lane: Release
  #####################################
  desc "Build, upload, and submit for App Review"
  lane :release do
    # Ensure clean working directory
    ensure_git_status_clean

    # Build app
    build

    # Upload metadata and screenshots
    metadata

    # Upload to App Store Connect
    api_key = app_store_connect_api_key_from_env
    deliver_options = {
      app_identifier: app_identifier,
      team_id: team_id,
      ipa: "./build/WhisperMate.ipa",
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        content_rights_has_rights: true,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    }
    deliver_options[:api_key] = api_key if api_key

    deliver(**deliver_options)

    # Create git tag
    version = get_version_number(
      xcodeproj: "Whispermate.xcodeproj",
      target: "WhisperMateIOS"
    )
    build_number = get_build_number(
      xcodeproj: "Whispermate.xcodeproj"
    )
    add_git_tag(
      tag: "ios-v#{version}-build-#{build_number}"
    )

    # Push to git
    push_to_git_remote

    UI.success("✅ Release submitted to App Store!")
  end

  #####################################
  # Lane: Quick Release (without submission)
  #####################################
  desc "Build and upload binary only (no auto-submit)"
  lane :upload do
    build

    deliver_options = {
      app_identifier: app_identifier,
      team_id: team_id,
      ipa: "./build/WhisperMate.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    }

    api_key = app_store_connect_api_key_from_env
    deliver_options[:api_key] = api_key if api_key

    deliver(**deliver_options)

    UI.success("✅ Binary uploaded to App Store Connect!")
  end

  #####################################
  # Lane: CI Upload
  #####################################
  desc "Build and upload binary from GitHub Actions"
  lane :ci_upload do
    api_key = app_store_connect_api_key_from_env
    UI.user_error!("App Store Connect API key environment variables are required") unless api_key

    build

    deliver(
      app_identifier: app_identifier,
      team_id: team_id,
      ipa: "./build/WhisperMate.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      api_key: api_key
    )

    UI.success("✅ CI binary uploaded to App Store Connect!")
  end

  #####################################
  # Lane: CI Submit Review
  #####################################
  desc "Submit the uploaded iOS build for App Review from GitHub Actions"
  lane :ci_submit_review do
    sh("node ../ci_scripts/submit_ios_app_review.js")
  end

  #####################################
  # Lane: Update Metadata Only
  #####################################
  desc "Update metadata without uploading a new build"
  lane :update_metadata do
    api_key = app_store_connect_api_key_from_env
    deliver_options = {
      app_identifier: app_identifier,
      team_id: team_id,
      skip_binary_upload: true,
    }
    deliver_options[:api_key] = api_key if api_key

    if File.directory?("./fastlane/screenshots")
      deliver_options[:screenshots_path] = "./fastlane/screenshots"
      deliver_options[:overwrite_screenshots] = true
    else
      deliver_options[:skip_screenshots] = true
    end

    deliver(**deliver_options)

    UI.success("✅ Metadata updated!")
  end

  #####################################
  # Error Handling
  #####################################
  error do |lane, exception|
    UI.error("❌ Error in lane '#{lane}': #{exception.message}")
  end

  #####################################
  # After All
  #####################################
  after_all do |lane|
    # Slack notification (optional)
    # slack(
    #   message: "Successfully executed '#{lane}' lane",
    #   success: true
    # )

    # Clean up build artifacts
    clean_build_artifacts unless ENV["KEEP_FASTLANE_BUILD_ARTIFACTS"].to_s == "1"
  end
end
